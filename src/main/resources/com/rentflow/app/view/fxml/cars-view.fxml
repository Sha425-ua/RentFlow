<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="scroll-pane-custom" stylesheets="@../css/cars.css" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.rentflow.app.controller.nav.CarsController">
    <children>
        <HBox alignment="CENTER_LEFT" prefHeight="50.0">
            <children>
                <VBox HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="title-4" text="Автомобілі" />
                        <Label styleClass="text-muted" text="Всього у системі: 24 автомобілів" />
                    </children>
                </VBox>
                <Button styleClass="accent" text="+ Додати автомобіль" />
            </children>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="card-stat">
            <children>
                <TextField fx:id="searchField" promptText="Пошук за моделлю або номером..." HBox.hgrow="ALWAYS" />
                <Button styleClass="button-outlined" text="Всі" />
                <Button styleClass="button-outlined" text="Вільні" />
                <Button styleClass="button-outlined" text="В оренді" />
                <Button styleClass="button-outlined" text="В ремонті" />
            </children>
        </HBox>

        <FlowPane fx:id="carsGrid" hgap="20.0" vgap="20.0" VBox.vgrow="ALWAYS" />
    </children>
</VBox>